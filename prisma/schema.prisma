// Orbyt Verify data model.
// Deliberately minimal PII: name + work email only. No SSN, no DOB, no criminal/
// employment records. We store IDV *results* (pass/fail, match score) — never the
// biometric itself (the IDV vendor holds that). This light footprint is part of
// what keeps the product out of CRA/consumer-report territory.
// JSON blobs are stored as strings (SQLite-safe) and parsed in code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Supabase pgbouncer, port 6543) — used by the serverless app.
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) — used by `prisma db push` / migrations.
  directUrl = env("DIRECT_URL")
}

model Org {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // --- Billing / plan (e-commerce) ---
  plan             String  @default("free")   // free | starter | scale | enterprise
  monthlyQuota     Int     @default(25)       // verifications included per calendar month
  billingStatus    String  @default("active") // active | past_due | canceled
  stripeCustomerId String?
  stripeSubId      String?

  users         User[]
  verifications Verification[]
}

model User {
  id           String   @id @default(cuid())
  orgId        String
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("member") // owner | admin | member
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?
  // Password reset: a single active, hashed, expiring token per user.
  resetTokenHash String?
  resetExpiresAt DateTime?

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Verification {
  id            String  @id @default(cuid())
  orgId         String
  candidateName String
  candidateEmail String
  // free-text context, e.g. "Senior Backend Engineer — remote contractor"
  roleContext   String  @default("")
  // claimed location (country ISO) the candidate/recruiter asserts
  declaredCountry String @default("")
  token         String  @unique @default(cuid())
  status        String  @default("pending") // pending | consented | submitted | complete | expired

  // --- results (populated on submit) ---
  riskScore     Int?     // 0..100 (higher = more likely fake/fraudulent)
  band          String?  // pass | review | risk
  verdict       String?  // human label
  signalsJson   String?  // JSON array of evaluated signals
  idvStatus     String?  // verified | requires_input | skipped | error
  idvProvider   String?
  idvSessionRef String?  // vendor session id (Stripe Identity)
  idName        String?  // full name extracted from the government ID (for name-match)
  selfieMatch   Float?
  livenessPassed Boolean?
  observedCountry String?
  // Deepfake analysis is async (RD upload -> poll). While this is set, the result
  // page finalizes the deepfake signal on poll. Cleared once resolved/given up.
  deepfakeRequestId String?
  behavioralJson  String?  // Feature 5: timing/interaction metadata (no keystrokes)
  frameStorageKeys String? // Feature 6: JSON array of Supabase Storage keys
  reviewDecision  String?  // Feature 6: "cleared" | "confirmed_fraud" | null
  reviewNotes     String?  // Feature 6: recruiter annotation

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  org      Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  consents Consent[]

  @@index([orgId])
  @@index([orgId, status])
}

model WebhookEndpoint {
  id              String    @id @default(cuid())
  orgId           String
  url             String
  secret          String    // HMAC-SHA256 signing secret
  events          String    // JSON array: ["verification.completed","verification.flagged"]
  enabled         Boolean   @default(true)
  createdAt       DateTime  @default(now())
  lastDeliveredAt DateTime?

  deliveries WebhookDelivery[]

  @@index([orgId])
}

model WebhookDelivery {
  id                  String   @id @default(cuid())
  endpointId          String
  verificationId      String
  event               String
  payloadJson         String
  responseStatus      Int?
  responseBodySnippet String?
  attemptCount        Int      @default(0)
  lastAttemptAt       DateTime?
  success             Boolean  @default(false)
  createdAt           DateTime @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId])
  @@index([verificationId])
}

model Consent {
  id             String   @id @default(cuid())
  verificationId String
  type           String   // BIOMETRIC | DATA_PROCESSING
  documentVersion String
  documentHash   String
  fullNameTyped  String
  ipAddress      String
  userAgent      String   @default("")
  retentionPolicy String  @default("")
  signedAt       DateTime @default(now())

  verification Verification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@index([verificationId])
}

model ApiKey {
  id          String    @id @default(cuid())
  orgId       String
  keyHash     String    @unique
  keyPrefix   String    // first 8 chars for display, e.g. "vfy_live"
  name        String
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  enabled     Boolean   @default(true)

  @@index([orgId])
}

model Integration {
  id        String   @id @default(cuid())
  orgId     String   @unique
  provider  String   // "greenhouse"
  config    String   // JSON: {harvestApiKey, webhookSecret, triggerStageId, jobIds[]}
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([orgId])
}

model ScoringProfile {
  id                String   @id @default(cuid())
  orgId             String   @unique
  weightsJson       String   @default("{}") // map of signal key → weight override
  bandThresholds    String   @default("{\"pass\":20,\"review\":45}") // {pass: number, review: number}
  useGlobalDefaults Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

// Append-only, hash-chained audit trail (no update/delete path in code).
model AuditEvent {
  id          String   @id @default(cuid())
  orgId       String?
  actor       String
  action      String
  entityType  String
  entityId    String
  payloadHash String
  prevHash    String?
  payloadJson String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([orgId])
}
